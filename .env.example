# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google AI Studio key (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Gemini Flash model ID (current stable Flash as of Oct 2026). Swap here, no code change needed.
GEMINI_MODEL=gemini-3.8-flash

# Neon Postgres connection string (Neon dashboard -> Connect -> pooled connection string).
# Server-side only. Never expose in the browser.
DATABASE_URL=

# Resend API key (resend.com -> API Keys)
RESEND_API_KEY=
# Where the brief is sent. On Resend's free tier without a verified domain,
# this must be the email you signed up to Resend with.
RECIPIENT_EMAIL=

# Long random string. Vercel cron sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# USD to INR rate used by code for conversions
FX_USD_INR=84
# http://localhost:3000 locally, your Vercel URL in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
